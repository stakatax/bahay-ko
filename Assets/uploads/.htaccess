# Only media generated by the upload services may be served directly.
# Documents remain available through the authorized PHP download route.
Options -Indexes -ExecCGI -Includes
SetHandler default-handler
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .shtml
<FilesMatch "(?i)^(?!.*\.(?:jpe?g|png|webp|mp3|m4a|wav|webm)$).*$">
    Require all denied
</FilesMatch>
# Block executable segments even when followed by an allowed media extension.
<FilesMatch "(?i)(?:^\.|\.(?:php[0-9]*|phtml|pht|phar|cgi|pl|py|shtml|htaccess)(?:\.|$))">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
